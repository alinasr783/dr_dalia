{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/specification/main/schema/mcp.json",
  "mcpServers": {
    "dr-dalia-articles-local": {
      "url": "http://localhost:3000/api/mcp",
      "type": "http",
      "permissions": {
        "tools": {
          "alwaysAllow": [
            "list_articles",
            "get_article",
            "create_article",
            "update_article",
            "delete_article",
            "list_categories",
            "get_clinic_seo_context"
          ]
        }
      }
    },
    "dr-dalia-articles-production": {
      "url": "https://drdalia-dental.com/api/mcp",
      "type": "http",
      "permissions": {
        "tools": {
          "alwaysAllow": [
            "list_articles",
            "get_article",
            "create_article",
            "update_article",
            "delete_article",
            "list_categories",
            "get_clinic_seo_context"
          ]
        }
      }
    }
  }
}
